{
    "name": "afaaro/demo",
    "description": "Modular PHP System Engine",
    "type": "project",
    "keywords": ["php", "cms", "framework", "modular"],
    "homepage": "https://github.com/afaaro/demo",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "System\\": "system/",
            "Modules\\": "modules/"
        },
        "files": [
            "maincore.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse system/ modules/ -l 5",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
